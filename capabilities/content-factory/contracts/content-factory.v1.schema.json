{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ginkgo.local/schemas/content-factory.v1.schema.json",
  "title": "Pyre Content Factory Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "skill",
    "request_id",
    "account_id",
    "objective",
    "niche",
    "platforms",
    "constraints"
  ],
  "properties": {
    "skill": {
      "const": "content.factory.run"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "account_id": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "enum": [
        "grow_audience",
        "generate_leads",
        "affiliate_revenue",
        "sponsorship_revenue",
        "owned_offer_revenue",
        "engagement",
        "experiment"
      ]
    },
    "niche": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "instagram",
          "tiktok",
          "youtube_shorts",
          "x",
          "facebook"
        ]
      }
    },
    "reference_inputs": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/referenceInput"
      }
    },
    "constraints": {
      "$ref": "#/$defs/constraints"
    },
    "monetization": {
      "$ref": "#/$defs/monetization"
    }
  },
  "$defs": {
    "referenceInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "uri", "rights_state"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["profile", "post", "asset", "analytics_export"]
        },
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "rights_state": {
          "$ref": "#/$defs/rightsState"
        },
        "notes": {
          "type": "string",
          "maxLength": 2000
        }
      }
    },
    "rightsState": {
      "type": "string",
      "enum": [
        "OWNED",
        "LICENSED",
        "GENERATED",
        "REFERENCE_ONLY",
        "UNKNOWN"
      ]
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["original_only", "approval_required"],
      "properties": {
        "original_only": {
          "const": true
        },
        "approval_required": {
          "type": "boolean"
        },
        "max_cost_usd": {
          "type": "number",
          "minimum": 0
        },
        "max_items": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "privacy": {
          "type": "string",
          "enum": ["local_only", "cloud_allowed"]
        },
        "timezone": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "monetization": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": {
          "type": "string",
          "enum": ["affiliate", "sponsorship", "owned_offer", "none"]
        },
        "assumptions": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        }
      }
    }
  }
}
