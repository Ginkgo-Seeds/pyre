# Pyre Backend — variáveis de ambiente (copiar para .env; NUNCA commitar .env)

# Servidor
PORT=3000

# Supabase (obrigatório para chat/content/publications/credits)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Creative Router — provider local (ComfyUI on-demand do ai-stack)
# Defaults corretos para o Pyre rodando no HOST (ComfyUI publica só em loopback).
# Se o Pyre rodar em container, ajustar COMFYUI_BASE_URL para a topologia adequada.
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_DEFAULT_MODEL=sd_xl_base_1.0.safetensors
COMFYUI_OUTPUT_ROOT=C:\AI\30-Assets\images\generated

# Creative Jobs — persistência (Wave 9). Postgres puro (localmente: Postgres do
# ecossistema ai-stack, schema dedicado `pyre`; em produção: Postgres do Supabase).
# Sem esta var, o repositório cai para IN-MEMORY (dev/testes; jobs não sobrevivem a restart).
CREATIVE_DB_URL=

# Lifecycle do runtime local (Wave 9) — valores de produção
CREATIVE_MIN_FREE_RAM_GIB=2.0
CREATIVE_IDLE_TTL_SECONDS=300
CREATIVE_MEMORY_FLOOR_GIB=1.5
CREATIVE_START_TIMEOUT_SECONDS=240

# Provider cloud — Google Gemini image (Wave 9). Modelo pinado + gate de custo.
GEMINI_API_KEY=
GOOGLE_IMAGE_MODEL=gemini-2.5-flash-image
MAX_CLOUD_TEST_COST_USD=0.25
