# Pyre Backend — variáveis de ambiente (copiar para .env; NUNCA commitar .env)

# Servidor
PORT=3000

# Supabase (obrigatório para chat/content/publications/credits)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Creative Router — provider local (ComfyUI on-demand do ai-stack)
# Defaults corretos para o Pyre rodando no HOST (ComfyUI publica só em loopback).
# Se o Pyre rodar em container, ajustar COMFYUI_BASE_URL para a topologia adequada.
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_DEFAULT_MODEL=sd_xl_base_1.0.safetensors
COMFYUI_OUTPUT_ROOT=C:\AI\30-Assets\images\generated
